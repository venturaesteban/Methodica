# Copia este archivo como keystore.properties en la raíz del repo.
# NO lo subas a git.

# Ruta del archivo .jks (relativa o absoluta)
storeFile=app/release-upload-key.jks

# Password del keystore
storePassword=CHANGE_ME

# Alias de la clave
keyAlias=upload

# Password de la clave
keyPassword=CHANGE_ME
